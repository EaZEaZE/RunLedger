  "experiment": {
    "id": "digits-small-sample",
    "title": "digits 小样本图像分类",
    "subtitle": "模型容量提升，还是随机种子的噪声？",
    "kind": "classification",
    "created_at": "2026-11-16T23:39:58+08:00",
    "duration_s": 4.057,
