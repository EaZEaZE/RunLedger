      "parameters": {
        "hidden_layer_sizes": [
          32
        ],
        "alpha": 0.0001,
        "max_iter": 220
      }
    },
    {
      "id": "mlp128",
      "name": "候选 · MLP 128",
      "short_name": "MLP 128",
      "description": "仅扩大单隐层宽度，检查容量提升是否超过种子波动。",
      "parameters": {
        "hidden_layer_sizes": [
          128
        ],
        "alpha": 0.0001,
        "max_iter": 220
      }
    },
    {
      "id": "mlp128_l2",
