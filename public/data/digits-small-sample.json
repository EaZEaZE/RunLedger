      "train_samples": 360,
      "test_samples": 540,
      "split_seed": 2026,
      "test_split_seed": 2027,
      "seeds": [
        11,
        29,
        47
      ],
      "control": "所有配置使用相同训练/测试划分；仅模型参数和MLP随机种子变化。",
      "limitations": "受控小样本实验，不代表完整digits或SGG任务上的最优性能。"
    },
    "environment": {
      "python": "3.9.13",
      "numpy": "2.0.2",
      "scipy": "1.13.1",
      "sklearn": "1.6.1",
      "platform": "Windows-10-10.0.26200-SP0",
