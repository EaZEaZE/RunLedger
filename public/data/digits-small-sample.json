        ],
        "alpha": 0.05,
        "max_iter": 220
      }
    },
    {
      "id": "mlp64x2",
      "name": "探索 · MLP 64×2",
      "short_name": "MLP 64×2",
      "description": "探索性双隐层配置，当前只执行一个种子，不能用于稳定排名。",
      "parameters": {
        "hidden_layer_sizes": [
          64,
          64
        ],
        "alpha": 0.0001,
        "max_iter": 220
      }
    }
  ],
