      "unit": "%",
      "higher_is_better": true
    },
    "baseline_config": "mlp32",
    "target_seeds": 3,
    "dataset": {
      "name": "sklearn digits / UCI Optical Recognition of Handwritten Digits",
      "samples": 1797,
      "features": 64,
      "classes": 10,
