{
  "schema_version": "1.1.0",
  "experiment": {
    "id": "sleep-next-day-steps",
    "title": "睡得更久后，第二天会走更多吗？",
    "subtitle": "以个人当夜睡眠中位数分组，比较次日真实步数 · 不推断睡眠的因果效果",
    "kind": "lifestyle",
    "created_at": "2026-11-16T18:16:58.630774+00:00",
    "duration_s": 0,
    "metric": {
      "key": "next_day_steps",
      "label": "次日步数",
      "unit": "步",
      "higher_is_better": true
    },
    "baseline_config": "shorter_sleep",
    "target_seeds": 18,
    "dataset": {
      "name": "FitBit Fitness Tracker Data / Fitabase 4.12.16–5.12.16",
      "source": "https://www.kaggle.com/datasets/arashnic/fitbit",
      "license_note": "Kaggle 数据卡标注 CC0: Public Domain；30名同意提交追踪器数据的Fitbit用户。仅作产品演示，不作医疗建议。",
      "period": "2016-04-12 至 2016-05-12（具体记录范围以原始文件为准）",
      "archive_download": "https://www.kaggle.com/api/v1/datasets/download/arashnic/fitbit",
      "archive_sha256": "263bb05592792d1dbbd4b3c40b3203e7083489e085b38303dcf7e151c932f870",
      "raw_files": [
        "dailyActivity_merged.csv",
        "sleepDay_merged.csv"
      ]
    },
    "design": {
      "analysis": "paired",
      "配对方式": "同一参与者的较短睡眠后与较长睡眠后记录使用相同 repeat 编号",
      "条件定义": "按每位参与者自身当夜睡眠时长中位数分为较短（<中位数）与较长（≥中位数）",
      "日期连接": "睡眠日期严格连接下一日历日的 TotalSteps；不使用下一条记录替代",
      "纳入规则": "次日 TotalSteps>0；当夜 TotalMinutesAsleep>0；每位参与者两种条件都至少有2个有效配对日",
      "分析单位": "先求每位参与者在各条件下的次日平均步数，再做配对比较",
      "因果边界": "睡眠时长未随机分配；同一人自身对照不能排除工作日、健康状态、活动安排等混杂，也不构成医疗诊断或睡眠建议"
    },
    "environment": {
      "生成脚本": "Python 3.9.13 标准库",
      "分析单位": "参与者在单个条件下的日均值",
      "随机生成": "无；不生成、不补值、不修改原始结果"
    }
  },
  "configs": [
    {
      "id": "shorter_sleep",
      "name": "较短睡眠后的次日",
      "short_name": "较短睡眠后",
      "description": "当夜睡眠低于该参与者个人中位数",
      "parameters": {
        "sleep_split": "< within-person median",
        "min_valid_pairs": 2
      }
    },
    {
      "id": "longer_sleep",
      "name": "较长睡眠后的次日",
      "short_name": "较长睡眠后",
      "description": "当夜睡眠大于或等于该参与者个人中位数",
      "parameters": {
        "sleep_split": ">= within-person median",
        "min_valid_pairs": 2
      }
    }
  ],
