{
  "schema_version": "1.0",
  "experiment": {
    "id": "local-performance",
    "title": "本地高斯模糊性能计时",
    "subtitle": "可分离卷积的加速，能否经受重复测量？",
    "kind": "performance",
    "created_at": "2026-11-16T23:39:59+08:00",
    "duration_s": 0.627,
    "metric": {
      "key": "latency_ms",
      "label": "单次耗时",
      "unit": "ms",
      "higher_is_better": false
    },
    "baseline_config": "full2d",
    "target_seeds": 15,
    "dataset": {
      "name": "sklearn 示例照片 china.jpg",
      "samples": 1,
      "shape": [
        427,
        640,
        3
      ],
      "source": "https://scikit-learn.org/stable/modules/generated/sklearn.datasets.load_sample_image.html",
      "license_note": "随 scikit-learn 分发的真实示例照片；本地离线加载。"
    },
    "design": {
      "repetitions": 15,
      "first_call_separate": true,
      "order": "预热测量按AB/BA交替，降低执行顺序与系统漂移偏差。",
      "control": "相同图片、相同5×5高斯核、相同reflect边界；已校验两种实现输出一致。",
      "limitations": "首次调用仅表示当前进程内第一次执行，不等于全新操作系统冷启动。"
    },
    "environment": {
      "python": "3.9.13",
      "numpy": "2.0.2",
      "scipy": "1.13.1",
      "sklearn": "1.6.1",
      "platform": "Windows-10-10.0.26200-SP0",
      "processor": "Intel64 Family 6 Model 154 Stepping 3, GenuineIntel",
      "logical_cpu": 16
    },
    "validation": {
      "output_allclose": true,
      "max_abs_error": 5.960464477539063e-08,
      "tolerance": "atol=1e-6, rtol=1e-5"
    }
  },
  "configs": [
    {
      "id": "full2d",
      "name": "基线 · 二维卷积",
      "short_name": "二维卷积",
      "description": "每个颜色通道执行一次5×5二维卷积。",
      "parameters": {
        "operation": "ndimage.convolve",
        "kernel": "5×5",
        "sigma": 1.2
      }
    },
    {
      "id": "separable",
      "name": "优化 · 可分离卷积",
      "short_name": "可分离卷积",
      "description": "将同一个高斯核拆成水平与垂直两次一维卷积。",
      "parameters": {
        "operation": "ndimage.convolve1d × 2",
        "kernel": "5 + 5",
        "sigma": 1.2
      }
    }
  ],
