{
  "schema_version": "1.1.0",
  "experiment": {
    "id": "weekend-steps",
    "title": "周末会走得更多吗？",
    "subtitle": "同一参与者的工作日与周末日均步数配对比较 · 公开观察性数据",
    "kind": "lifestyle",
    "created_at": "2026-11-16T18:16:58.624431+00:00",
    "duration_s": 0,
    "metric": {
      "key": "daily_steps",
      "label": "日均步数",
      "unit": "步",
      "higher_is_better": true
    },
    "baseline_config": "weekday",
    "target_seeds": 32,
    "dataset": {
      "name": "FitBit Fitness Tracker Data / Fitabase 4.12.16–5.12.16",
      "source": "https://www.kaggle.com/datasets/arashnic/fitbit",
      "license_note": "Kaggle 数据卡标注 CC0: Public Domain；30名同意提交追踪器数据的Fitbit用户。仅作产品演示，不作医疗建议。",
      "period": "2016-04-12 至 2016-05-12（具体记录范围以原始文件为准）",
      "archive_download": "https://www.kaggle.com/api/v1/datasets/download/arashnic/fitbit",
      "archive_sha256": "263bb05592792d1dbbd4b3c40b3203e7083489e085b38303dcf7e151c932f870",
      "raw_files": [
        "dailyActivity_merged.csv",
        "sleepDay_merged.csv"
      ]
    },
    "design": {
      "analysis": "paired",
      "配对方式": "同一参与者的 weekday 与 weekend 记录使用相同 repeat 编号",
      "条件定义": "周一至周五为工作日；周六、周日为周末",
      "纳入规则": "TotalSteps>0；每位参与者在两种条件下都至少有2个有效日",
      "分析单位": "先求每位参与者在各条件下的日均步数，再比较参与者条件均值",
      "因果边界": "未随机分配星期，结果只描述观察性关联；季节、工作、佩戴习惯等混杂仍可能存在"
    },
    "environment": {
      "生成脚本": "Python 3.9.13 标准库",
      "分析单位": "参与者在单个条件下的日均值",
      "随机生成": "无；不生成、不补值、不修改原始结果"
    }
  },
  "configs": [
    {
      "id": "weekday",
      "name": "工作日",
      "short_name": "工作日",
      "description": "周一至周五且步数大于0的日期",
      "parameters": {
        "days": "Monday–Friday",
        "min_valid_days": 2
      }
    },
    {
      "id": "weekend",
      "name": "周末",
      "short_name": "周末",
      "description": "周六、周日且步数大于0的日期",
      "parameters": {
        "days": "Saturday–Sunday",
        "min_valid_days": 2
      }
    }
  ],
